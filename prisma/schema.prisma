// Chef İlhamə Database Schema - v2 (normalized)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Recipe {
  id                 String        @id @default(cuid())
  yemeyinAdi         String
  slug               String        @unique
  hazirlanmaMuddeti  String
  cetinlikDerecesi   String
  porsiyaSayi        String
  tarixiMelumat      String?       @db.Text
  teqdimTeklifleri   String?       @db.Text
  featured           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  kateqoriyaId       String
  kateqoriya         Category      @relation(fields: [kateqoriyaId], references: [id])

  menseId            String?
  mense              Mense?        @relation(fields: [menseId], references: [id])

  bolgeId            String?
  bolge              Bolge?        @relation(fields: [bolgeId], references: [id])

  terkibHisseleri    Ingredient[]
  addimlar           Step[]
  sekiller           RecipeImage[]

  @@map("recipes")
}

model Category {
  id      String   @id @default(uuid())
  ad      String   @unique
  recipes Recipe[]

  @@map("categories")
}

model Mense {
  id      String   @id @default(uuid())
  ad      String   @unique
  recipes Recipe[]

  @@map("menseler")
}

model Bolge {
  id      String   @id @default(uuid())
  ad      String   @unique
  recipes Recipe[]

  @@map("bolgeler")
}

model Cetinlik {
  id   String @id @default(uuid()) @db.Uuid
  ad   String @unique
  sira Int    @default(0)

  @@map("cetinlikler")
}

model Muddet {
  id   String @id @default(uuid()) @db.Uuid
  ad   String @unique
  sira Int    @default(0)

  @@map("muddetler")
}

model Porsiya {
  id     String  @id @default(uuid()) @db.Uuid
  ad     String
  miqdar String?
  sira   Int     @default(0)

  @@map("porsiyalar")
  @@unique([ad, miqdar])
}

model Ingredient {
  id       String  @id @default(cuid())
  ad       String
  miqdar   String?
  sira     Int     @default(0)
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("ingredients")
  @@index([recipeId])
}

model Step {
  id       String @id @default(cuid())
  metn     String @db.Text
  sira     Int    @default(0)
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("steps")
  @@index([recipeId])
}

model RecipeImage {
  id       String  @id @default(cuid())
  url      String
  isMain   Boolean @default(true)
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("recipe_images")
  @@index([recipeId])
}
