// Chef İlhamə Database Schema - v2 (normalized)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Recipe {
  id                String   @id @default(cuid())
  yemeyinAdi        String
  slug              String   @unique
  hazirlanmaMuddeti String
  cetinlikDerecesi  String
  porsiyaSayi       String
  tarixiMelumat     String?  @db.Text
  teqdimTeklifleri  String?  @db.Text
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  kateqoriyaId String
  kateqoriya   Category @relation(fields: [kateqoriyaId], references: [id])

  menseId String?
  mense   Mense?  @relation(fields: [menseId], references: [id])

  bolgeId String?
  bolge   Bolge?  @relation(fields: [bolgeId], references: [id])

  yemeyinAdiEn        String?
  hazirlanmaMuddetiEn String?
  cetinlikDerecesiEn  String?
  porsiyaSayiEn       String?
  tarixiMelumatEn     String? @db.Text
  teqdimTeklifleriEn  String? @db.Text

  terkibHisseleri Ingredient[]
  addimlar        Step[]
  sekiller        RecipeImage[]
  sources         RecipeSource[]

  @@map("recipes")
}

model Category {
  id      String   @id @default(uuid())
  ad      String   @unique
  adEn    String?
  recipes Recipe[]

  @@map("categories")
}

model Mense {
  id      String   @id @default(uuid())
  ad      String   @unique
  adEn    String?
  recipes Recipe[]

  @@map("menseler")
}

model Bolge {
  id      String   @id @default(uuid())
  ad      String   @unique
  adEn    String?
  recipes Recipe[]

  @@map("bolgeler")
}

model Cetinlik {
  id   String  @id @default(uuid()) @db.Uuid
  ad   String  @unique
  adEn String?
  sira Int     @default(0)

  @@map("cetinlikler")
}

model Muddet {
  id   String  @id @default(uuid()) @db.Uuid
  ad   String  @unique
  adEn String?
  sira Int     @default(0)

  @@map("muddetler")
}

model Porsiya {
  id     String  @id @default(uuid()) @db.Uuid
  ad     String
  adEn   String?
  miqdar String?
  sira   Int     @default(0)

  @@unique([ad, miqdar])
  @@map("porsiyalar")
}

model Ingredient {
  id       String              @id @default(cuid())
  ad       String
  adEn     String?
  miqdarId String?             @db.Uuid
  miqdar   IngredientQuantity? @relation(fields: [miqdarId], references: [id])
  sira     Int                 @default(0)
  recipeId String
  recipe   Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([miqdarId])
  @@map("ingredients")
}

model IngredientQuantity {
  id          String       @id @default(uuid()) @db.Uuid
  ad          String
  adEn        String?
  miqdar      String?
  ingredients Ingredient[]

  @@unique([ad, miqdar])
  @@map("olculer")
}

model Step {
  id       String  @id @default(cuid())
  metn     String  @db.Text
  metnEn   String? @db.Text
  sira     Int     @default(0)
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("steps")
}

model RecipeImage {
  id         String  @id @default(cuid())
  url        String
  isMain     Boolean @default(true)
  altAz      String?
  altEn      String?
  credit     String? @db.Text
  sourceUrl  String?
  license    String?
  licenseUrl String?
  width      Int?
  height     Int?
  recipeId   String
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@map("recipe_images")
}

model RecipeSource {
  id       String  @id @default(cuid())
  title    String?
  url      String
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, url])
  @@index([recipeId])
  @@map("recipe_sources")
}
